{
  "functions": {
    "api/room.js": {
      "maxDuration": 20
    },
    "api/book.js": {
      "maxDuration": 20
    },
    "api/booking-qr.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/book.html", "destination": "/public/book.html" }
  ],
  "headers": [
    {
      "source": "/public/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
